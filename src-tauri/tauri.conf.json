{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipStash",
  "version": "../package.json",
  "identifier": "com.itsazaira.clipstash",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "popup",
        "title": "ClipStash",
        "url": "index.html",
        "width": 420,
        "height": 520,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "visible": false,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "publisher": "Its Azaira",
    "copyright": "Copyright (c) 2026 Its Azaira. MIT licence.",
    "category": "Utility",
    "shortDescription": "Your last 50 copies, one shortcut away.",
    "longDescription": "ClipStash keeps your last 50 copied text items. Press one shortcut, click an item, and it pastes into the app you were using. Everything stays on your device.",
    "homepage": "https://itsazaira.com",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  }
}
